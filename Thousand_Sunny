## Example Configuration Cisco Cli ##

##Example Router##

enable
configure terminal
hostname Thousand_Sunny
enable secret WillofD
username Luffy secret Monkey D


access-list 1 permit 10.0.0.0 0.0.0.255
ip domain-name Strawhats
crypto key generate rsa
line console 0
 exec-timeout 30
 logging synchronous
 login local
line vty 0 15
 transport input ssh
 login local
 access-class 1 in
 logging syncronous

router ospf 10
 router-id 10.0.0.1
 passive-interface Loopback0
 network 10.0.0.0 0.0.0.255 area 0
 network 10.0.0.1 0.0.0.0 area 0

interface loopback0
 ip address 10.0.1.1
 ip ospf 10 area 0

ipv6 unicast-routing
interface G0/01
 ip address 192.168.0.10 255.255.255.252
 ip nat inside
 ipv6 address 2001:db8:A1::1/64
 ip ospf 10 area 0  
 no shutdown
 
ip dhcp excluded-address 10.0.0.1 10.0.0.10
ip dhcp pool SH-PC
 network 10.1.1.0 255.255.255.0
 default-router 10.1.0.10
 dns-server 10.10.10.10
 domain-name Strawhats.com

ntp master 10
no cdp run
lldp run

