## Example Configuration Cisco CLI ##

##Example Router##

enable
configure terminal
hostname Thousand_Sunny
enable secret WillofD
username Luffy secret MonkeyD


access-list 1 permit 10.0.0.0 0.0.255.255
ip domain-name Strawhats.com
crypto key generate rsa
ip ssh version 2
line console 0
 exec-timeout 30
 logging synchronous
 login local
line vty 0 15
 transport input ssh
 login local
 access-class 1 in
 logging synchronous

interface loopback0
 ip address 10.0.0.1 255.255.255.255

router ospf 10
 router-id 10.0.0.1
 passive-interface Loopback0
 passive-interface g0/0
 network 10.0.0.0 0.0.0.255 area 0

ipv6 unicast-routing
interface g0/1
 ip address 10.1.1.1 255.255.255.252
 ip nat outside
 ipv6 address 2001:db8:A1::1/64
 ip ospf 10 area 0  
 ip ospf priority 100
 no shutdown

ip access-list extended Nika
 deny tcp any any eq 23
 permit ip any any

interface g0/0
 ip address 10.0.10.1 255.255.255.0
 description  Addressing scheme mostly for theme 
 ip access-group Nika in
 ip ospf 10 area 0
 ip nat inside
 no shutdown

access-list 10 permit 10.0.10.0 0.0.0.255
ip nat inside source list 10 interface g0/1 overload

ip dhcp excluded-address 10.0.10.1 10.0.10.10
ip dhcp pool SH_PC
 network 10.0.10.0 255.255.255.0
 default-router 10.0.10.1
 dns-server 10.10.10.10
 domain-name Strawhats.com

ntp master 10
no cdp run
lldp run
do write

## Core Switch Example ##

enable
configure terminal
hostname CS1
enable secret Enma
username Zoro algorithm-type scrypt secret Wano


ip domain-name Strawhats.com
crypto key generate rsa
ip ssh version 2
access-list 1 permit 10.0.0.0 0.0.255.255
line console 0
 exec-timeout 30
 logging synchronous
 login local
line vty 0 15
 transport input ssh
 login local
 access-class 1 in
 logging synchronous

vlan 99
 name Zoro_Directions
interface vlan 99
 ip address 10.0.10.2 255.255.255.0
 no shutdown
ip default-gateway 10.0.10.1
interface g1/2
 switchport mode access
 switchport access vlan 99

interface loopback0
 ip address 10.0.0.2 255.255.255.255

router ospf 10
 router-id 10.0.0.2
 passive-interface Loopback0
 network 10.0.0.2 0.0.0.0 area 0

interface range g2/11-20
 shutdown

ip name-server 10.10.10.10
ntp server 10.10.10.100
no cdp run
lldp run
spanning-tree mode rapid-pvst
do write

