## Example Configuration Cisco CLI ##

##Example Router##

enable
configure terminal
hostname Thousand_Sunny
enable secret WillofD
username Luffy secret MonkeyD


access-list 1 permit 10.0.0.0 0.0.0.255
ip domain-name Strawhats
crypto key generate rsa
ip ssh version 2
line console 0
 exec-timeout 30
 logging synchronous
 login local
line vty 0 15
 transport input ssh
 login local
 access-class 1 in
 logging synchronous

interface loopback0
 ip address 10.0.0.1 255.255.255.255

router ospf 10
 router-id 10.0.0.1
 passive-interface Loopback0
 network 10.0.0.0 0.0.0.255 area 0

ipv6 unicast-routing
interface g0/1
 ip address 10.1.1.1 255.255.255.252
 ip nat inside
 ipv6 address 2001:db8:A1::1/64
 ip ospf 10 area 0  
 ip ospf priority 100
 no shutdown

ip access-list extended Nika
 permit ip any any

interface g0/0
 ip address 192.168.10.1 255.255.255.0
 description  Addressing scheme mostly for theme 
 ip access-group Nika in
 no shutdown
 
ip dhcp excluded-address 10.0.0.1 10.0.0.10
ip dhcp excluded-address 192.168.0.0 192.168.0.30
ip dhcp pool SH_PC
 network 192.168.10.0 255.255.255.0
 default-router 192.168.10.1
 dns-server 10.10.10.10
 domain-name Strawhats.com

ntp master 10
no cdp run
lldp run
do write

